{
  "name": "maxmotor-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "inventory:import": "node scripts/import-inventory-compatibility.mjs",
    "build:styles": "tailwindcss -c tailwind.config.cjs -i styles/engineering.css -o assets/engineering-b2b.css --minify",
    "build": "npm run build:styles && node scripts/build-static.mjs",
    "check": "node scripts/check-project.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm run check && npm test",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=maxmotor-platform",
    "dev": "wrangler pages dev dist",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.dev.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.120.0"
  }
}
